<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>io.github.sander_i</groupId>
  <artifactId>gal-world-portal</artifactId>
  <!-- 版本号唯一来源：升级只改这一行。
       application.yml 用 @project.version@ 注入，构建脚本与 README 不再硬编码。 -->
  <version>0.0.1</version>
  <name>gal-world-portal</name>
  <description>Gal World 门户：游戏库、会话管理、元数据</description>
  <url>https://gitee.com/sander-o/gal-world</url>

  <scm>
    <connection>scm:git:https://gitee.com/sander-o/gal-world.git</connection>
    <developerConnection>scm:git:https://gitee.com/sander-o/gal-world.git</developerConnection>
    <url>https://gitee.com/sander-o/gal-world</url>
  </scm>

  <developers>
    <developer>
      <id>sander</id>
      <name>sander</name>
      <url>https://gitee.com/sander-o</url>
    </developer>
  </developers>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>net.coobird</groupId>
      <artifactId>thumbnailator</artifactId>
      <version>0.4.8</version>
    </dependency>

    <!-- 游戏上传：zip/7z 解压。xz 提供 7z 的 LZMA/LZMA2 编码。 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.26.1</version>
    </dependency>
    <dependency>
      <groupId>org.tukaani</groupId>
      <artifactId>xz</artifactId>
      <version>1.9</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- 合规：把项目 LICENSE、第三方组件声明与各许可证全文打进 META-INF/ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-license-notices</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/..</directory>
                  <includes>
                    <include>LICENSE</include>
                    <include>THIRD-PARTY-NOTICES.md</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
                <resource>
                  <directory>${project.basedir}/../licenses</directory>
                  <targetPath>licenses</targetPath>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
          <!-- 远程更新：Windows 更新器随 jar 分发，运行时释放到 <root>\data\update\ -->
          <execution>
            <id>copy-windows-updater</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/deploy/windows</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../deploy/win</directory>
                  <includes>
                    <include>update-portal.ps1</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 合规：构建期扫描依赖树生成第三方许可证清单，升级依赖后自动反映 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.8.0</version>
        <executions>
          <execution>
            <id>third-party-licenses</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
          <thirdPartyFilename>THIRD-PARTY-DEPENDENCIES.txt</thirdPartyFilename>
          <useMissingFile>false</useMissingFile>
          <failOnMissing>false</failOnMissing>
          <excludedScopes>test</excludedScopes>
          <licenseMerges>
            <licenseMerge>The Apache Software License|Apache License, Version 2.0|Apache-2.0|Apache 2.0|Apache License 2.0|Apache License|ASL 2.0|Apache License v2.0|The Apache License, Version 2.0|http://www.apache.org/licenses/LICENSE-2.0.txt|https://www.apache.org/licenses/LICENSE-2.0.txt|http://www.apache.org/licenses/LICENSE-2.0|https://www.apache.org/licenses/LICENSE-2.0|Apache 2|Apache License Version 2.0</licenseMerge>
          </licenseMerges>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
