# game.env 模板：复制为同目录下的 game.env 后按本机环境修改。
# 真实 game.env 是实例状态（显示号/端口/slot/绝对路径），由接入向导生成，不入版本库。
GAME_ID=demo-game
GAME_NAME=示例游戏 B
EXE=${GALWORLD_ROOT:-$HOME/galworld}/games/demo-game/game.exe
WORKDIR=${GALWORLD_ROOT:-$HOME/galworld}/games/demo-game
WINEPREFIX=${GALWORLD_ROOT:-$HOME/galworld}/games/demo-game/wineprefix
WIDTH=1280
HEIGHT=720
# 以下三项按自动分配结果填写
DISPLAY_NUM=3
PORT=9003
LOOPBACK_SLOT=1
FRAMERATE=30-30
EXTRA_ENV=
