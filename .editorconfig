# 统一编辑器行为，避免换行符 / 缩进差异产生无意义 diff。
# 换行符原则与 .gitattributes 一致：脚本与源码一律 LF，Windows 批处理用 CRLF。
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[*.{sh,service,rules}]
indent_size = 2

[*.md]
# Markdown 行尾两个空格是换行语义，不能被自动裁掉
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf

[Makefile]
indent_style = tab
