#
# 阻止直接推送 master 到主仓库。
#
# master 只允许通过 PR 合并进入（GitHub 侧已开 enforce_admins）。2026-11-20 出过一次：
# 用户说「部署到线上验证」，代理把两个分支 merge 进 master 并推了 gitee + github，
# 绕过了 PR 审批。
#
# 启用方式（每台 clone 后执行一次）：
#   git config core.hooksPath .githooks
#
# 临时绕过（GitHub 侧仍会被远端拒绝）：
#   git push --no-verify <remote> master

protected_branch="refs/heads/master"

# 只读镜像远端：允许推 master。它们只是备份，不是代码源。
#
# 只有 gitlab：内网备份仓，按镜像方式同步（见 project_galworld_release_channels）。
#
# **不要往这里加 gitee。** Gitee 虽然由平台从 GitHub 自动同步代码，但它同样
# 只允许通过 PR 合并 master —— 用户 2026-11-20 明确要求「github 和 gitee 只允许
# 创建 pr 不允许直接推送 master，这个规则不能改」。
mirror_remotes=" gitlab "

# 远端名不是 stdin 给的，取第一个位置参数（pre-push 的 $1）。
remote_name="${1:-}"

case "$mirror_remotes" in
    *" $remote_name "*) exit 0 ;;
esac

# stdin 每行是「<local ref> <local sha> <remote ref> <remote sha>」
while read -r local_ref local_sha remote_ref remote_sha; do
    # 删除分支（local sha 全 0）不拦：那是清理，不是往 master 加东西
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    if [ "$remote_ref" = "$protected_branch" ]; then
        echo "" >&2
        echo "================================================================" >&2
        echo "  拒绝：不允许直接推送 master 到 $remote_name" >&2
        echo "================================================================" >&2
        echo "" >&2
        echo "  master 只允许通过 Pull Request 合并进入。" >&2
        echo "" >&2
        echo "  正确流程：" >&2
        echo "    1. git checkout -b <新分支>" >&2
        echo "    2. git commit ..." >&2
        echo "    3. git push -u github <新分支>" >&2
        echo "    4. 在网页上创建 PR，由仓库所有者合并" >&2
        echo "" >&2
        echo "  同步只读镜像（gitlab / gitee）不受此限制。" >&2
        echo "  确实需要直接推送时（GitHub 侧仍会被远端拒绝）：" >&2
        echo "    git push --no-verify $remote_name master" >&2
        echo "" >&2
        exit 1
    fi
done

exit 0
