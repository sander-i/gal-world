# 服务器端脚本必须在 Linux 上可直接执行，强制 LF
*.sh text eol=lf
galworld text eol=lf
mvnw text eol=lf
# Windows 批处理必须是 CRLF，否则 cmd 会把行尾当命令参数
*.cmd text eol=crlf
*.service text eol=lf
*.conf text eol=lf
*.rules text eol=lf
*.env text eol=lf
*.env.example text eol=lf

*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
LICENSE text eol=lf
licenses/*.txt text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.dat binary
